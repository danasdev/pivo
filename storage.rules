rules_version = '2';

// Fotos de produto: qualquer pessoa vê, só admin envia (imagem de até 5 MB).
// Publicar: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /produtos/{arquivo} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && arquivo.matches('[a-z0-9-]+[.](jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /{tudo=**} {
      allow read, write: if false;
    }
  }
}
